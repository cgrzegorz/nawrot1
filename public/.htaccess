# Dźwigi Nawrot — konfiguracja hostingu Apache dla statycznego eksportu Next.js

# 1. Przekierowania 301 ze starych adresów Joomli (zachowanie pozycji w Google)
<IfModule mod_rewrite.c>
  RewriteEngine On

  # jedna kanoniczna domena: bez www, po HTTPS
  RewriteCond %{HTTPS} off [OR]
  RewriteCond %{HTTP_HOST} ^www\. [NC]
  RewriteRule ^(.*)$ https://dzwigi-nawrot.pl/$1 [R=301,L]

  RewriteRule ^index\.php/o-firmie/?$   /o-firmie/   [R=301,L,NC]
  RewriteRule ^index\.php/partnerzy/?$  /partnerzy/  [R=301,L,NC]
  RewriteRule ^index\.php/galeria/?$    /galeria/    [R=301,L,NC]
  RewriteRule ^index\.php/kontakt/?$    /kontakt/    [R=301,L,NC]
  RewriteRule ^index\.php/?$            /            [R=301,L,NC]

  # stare adresy galerii Phoca -> nowa galeria
  RewriteRule ^index\.php/galeria/.*$   /galeria/    [R=301,L,NC]
</IfModule>

# 2. Strona błędu 404 wygenerowana przez Next.js
ErrorDocument 404 /404.html

# 3. Kompresja
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/javascript application/json image/svg+xml
</IfModule>

# 4. Cache — zasoby z hashem w nazwie trzymamy rok, HTML odświeżamy zawsze
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/webp            "access plus 1 year"
  ExpiresByType image/jpeg            "access plus 1 year"
  ExpiresByType image/png             "access plus 1 year"
  ExpiresByType image/svg+xml         "access plus 1 year"
  ExpiresByType font/woff2            "access plus 1 year"
  ExpiresByType text/css              "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/html             "access plus 0 seconds"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(webp|jpg|jpeg|png|svg|woff2|css|js)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
